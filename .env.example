# ==============================================================================
# Variáveis de Ambiente — Apoio ao Tratamento (Cloudflare D1 & Docker)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados Cloudflare D1 (Opcional para ambiente local, Obrigatório para Nuvem)
# ------------------------------------------------------------------------------
# Se preenchidas, a aplicação conecta diretamente ao Cloudflare D1 na borda (Edge).
# Se vazias, a aplicação utiliza a engine nativa SQLite compatível 1:1 com o Cloudflare D1.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------------------------
# 2. Inteligência Artificial (Google Gemini)
# ------------------------------------------------------------------------------
# Obtenha sua chave no Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 3. Credenciais Padrão de Acesso (E-mail e Senha)
# ------------------------------------------------------------------------------
# Administrador Geral (Acesso total às rotas, metas, auditoria e cadastros)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Atendente Farmacêutico (Modo somente leitura ao Dashboard e Perfil)
ATENDENTE_EMAIL=
ATENDENTE_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Configuração de Rede e Portas
# ------------------------------------------------------------------------------
PORT=4000

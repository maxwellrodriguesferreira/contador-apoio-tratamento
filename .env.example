# ==============================================================================
# Configuração de Ambiente — Apoio ao Tratamento (Modelo .env.example)
# NUNCA insira credenciais de produção reais neste arquivo.
# Copie este arquivo para .env e preencha com suas chaves seguras.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Rede Docker Compartilhada & Portas
# ------------------------------------------------------------------------------
DOCKER_SHARED_NETWORK=rede-proxy
APP_PORT=3000
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Banco de Dados Cloudflare D1 (Produção)
# (Se omitido, o sistema utilizará o motor SQLite nativo persistido em /app/data)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=seu_cloudflare_account_id_aqui
CLOUDFLARE_DATABASE_ID=seu_cloudflare_database_id_uuid_aqui
CLOUDFLARE_API_TOKEN=seu_cloudflare_api_token_aqui

# ------------------------------------------------------------------------------
# 3. Inteligência Artificial (Google Gemini)
# Obtenha sua chave gratuitamente em: https://ai.google.dev/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=sua_chave_gemini_api_studio_aqui
GEMINI_DEFAULT_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 4. Credenciais Iniciais de Administrador
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=DefinaSuaSenhaForteAqui123$

ATENDENTE_EMAIL=
ATENDENTE_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Rate Limiting e Cache Distribuído (Upstash Redis - Opcional)
# Exemplo: rediss://default:senha@endpoint.upstash.io:6379
# ------------------------------------------------------------------------------
REDIS_URL=
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ------------------------------------------------------------------------------
# 6. Persistência Local
# ------------------------------------------------------------------------------
DATABASE_DIR=/app/data

# ------------------------------------------------------------------------------
# 7. Configuração de Envio de E-mails (SMTP ou Resend - Opcional)
# Necessário para receber códigos de recuperação de senha por e-mail real.
# (Se não configurado, o sistema exibirá o código de segurança diretamente em tela como contingência)
# ------------------------------------------------------------------------------
# Exemplo SMTP (Gmail, Outlook, Hostinger, Locaweb, etc.):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Apoio ao Tratamento <seu-email@seudominio.com.br>"
SMTP_SECURE=false

# Ou se preferir usar a API do Resend (https://resend.com):
# RESEND_API_KEY=
# EMAIL_FROM=nao-responda@seudominio.com.br


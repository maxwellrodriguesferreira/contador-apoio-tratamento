# ==============================================================================
# Variáveis de Ambiente — Apoio ao Tratamento (Single Container & Docker)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Rede Docker Compartilhada & Portas
# ------------------------------------------------------------------------------
# Nome da rede docker externa compartilhada com o Nginx Proxy Manager (rede-proxy).
# Se a rede ainda não existir no host, crie com: docker network create rede-proxy
DOCKER_SHARED_NETWORK=rede-proxy

# Porta exposta no host para a aplicação unificada (acesso direto ou via proxy)
APP_PORT=3000
PORT=3000

# ------------------------------------------------------------------------------
# 2. Banco de Dados Cloudflare D1 (Opcional para ambiente local, Obrigatório para Nuvem)
# ------------------------------------------------------------------------------
# Se preenchidas, a aplicação conecta diretamente ao Cloudflare D1 na borda (Edge).
# Se vazias, a aplicação utiliza a engine nativa SQLite compatível 1:1 com o Cloudflare D1.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# Aliases suportados alternativamente:
# CF_ACCOUNT_ID=
# CF_D1_DB_ID=
# CF_D1_TOKEN=

# ------------------------------------------------------------------------------
# 3. Inteligência Artificial (Google Gemini)
# ------------------------------------------------------------------------------
# Obtenha sua chave no Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 4. Credenciais de Acesso (E-mail e Senha)
# ------------------------------------------------------------------------------
# Administrador Geral (Acesso total às rotas, metas, auditoria e cadastros)
# Suporta também os aliases: APP_ADMIN_MAIL e APP_ADMIN_PASS
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=

# Atendente Farmacêutico (Modo somente leitura ao Dashboard e Perfil)
ATENDENTE_EMAIL=atendente@suaempresa.com.br
ATENDENTE_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Rate Limiting e Cache Distribuído (Redis)
# ------------------------------------------------------------------------------
# Senha de proteção do Redis
REDIS_PASSWORD=redis123
# URL de conexão (utilizada pelo app para conectar no serviço redis)
REDIS_URL=redis://:redis123@redis:6379
# Número máximo de tentativas falhas de login antes do bloqueio
LOGIN_RATE_LIMIT_MAX=5
# Janela de tempo do bloqueio em milissegundos (900000ms = 15 minutos)
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ------------------------------------------------------------------------------
# 6. Configuração Interna
# ------------------------------------------------------------------------------
DATABASE_DIR=/app/data


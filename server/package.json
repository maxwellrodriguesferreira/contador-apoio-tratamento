{
  "name": "contador-apoio-tratamento-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API com Cloudflare D1 e Google Gemini para o sistema Apoio ao Tratamento",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --no-warnings --loader ts-node/esm src/index.ts",
    "build": "tsc && node -e \"import('node:fs').then(fs => fs.cpSync('src/db/schema.sql', 'dist/db/schema.sql', { force: true }))\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^6.0.0",
    "rate-limit-redis": "^6.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
